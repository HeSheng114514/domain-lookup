# 依赖(运行时零依赖,这些只是打包桌面版用的开发依赖)
node_modules/

# 打包产物(用 node tools/build-desktop.js / build-web.js 重新生成)
dist/
out/
*.asar

# 网页端打包中间产物(由 tools/build-web.js 生成,可重建)
build/web-bundle.cjs
build/sea-config.json
build/sea-prep.blob

# 图标是产物但需要提交(打包时要用),所以 build/icon.ico 与 icon.png 保留

# 密钥与凭据 —— 防御性规则,避免误提交
*.token
GitHub-Token.txt
*token*.txt
.env
.env.local
.env.*.local

# 编辑器与系统
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
npm-debug.log*
yarn-error.log*
*.tmp
*.bak
*.orig

# 桌面版自检报告
*-selftest.txt
