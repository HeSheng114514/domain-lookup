# 依赖(运行时零依赖,这些只是打包桌面版用的开发依赖)
node_modules/

# 打包产物(用 node tools/build-desktop.js 重新生成)
dist/
out/
*.asar

# 密钥与凭据 —— 防御性规则,避免误提交
*.token
GitHub-Token.txt
*token*.txt
.env
.env.local
.env.*.local

# 编辑器与系统
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
npm-debug.log*
yarn-error.log*
*.tmp
*.bak
*.orig

# 桌面版自检报告
*-selftest.txt
